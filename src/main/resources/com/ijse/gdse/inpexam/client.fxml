<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="btnImage" onDragDetected="#btnImageOnAction" prefHeight="697.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ijse.gdse.inpexam.client.ChatClient">
   <children>
      <Label layoutX="204.0" layoutY="27.0" text="Client">
         <font>
            <Font name="System Bold" size="38.0" />
         </font>
      </Label>
      <ListView fx:id="messageView" layoutX="49.0" layoutY="110.0" prefHeight="410.0" prefWidth="451.0" />
      <TextField fx:id="txtMessage" layoutX="49.0" layoutY="565.0" prefHeight="47.0" prefWidth="310.0" promptText="Type Your Message here">
         <font>
            <Font size="17.0" />
         </font></TextField>
      <Button fx:id="btnSend" layoutX="373.0" layoutY="568.0" mnemonicParsing="false" onAction="#btnSendOnAction" prefHeight="41.0" prefWidth="104.0" text="Send">
         <font>
            <Font name="System Bold Italic" size="19.0" />
         </font>
      </Button>
      <Button layoutX="176.0" layoutY="634.0" mnemonicParsing="false" prefHeight="32.0" prefWidth="186.0" text="Image Send">
         <font>
            <Font name="System Bold Italic" size="16.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
